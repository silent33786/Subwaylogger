# Virtual Environment
.venv/
venv/
env/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.pytest_cache/

# User Data, Logs, and Backups (Sensitive)
profiles/
backups/
data/
logs/
*.log
@AutomationLog.txt

# SQLite Databases & Storage
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db-journal

# Screenshots and Temporary Crops
*.png
*.jpg
*.jpeg
agent_shots/

# Tools & Portable Binaries
tools/

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Secrets - never commit these. Passwords are only accepted via
# FB_PASSWORD env var, getpass() prompt, or the OS vault.
.env
*.env
.env.*
!.env.example
vault.key
vault.enc
agent_memory.json
agent_memory.json.tmp
# Local manual smoke test - it handles real credentials (env/getpass only)
test_no_mouse.py
# Any local account list used with --batch-fb
accounts.txt
*.accounts.txt
